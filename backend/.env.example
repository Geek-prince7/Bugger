OIDC_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
COGNITO_CLIENT_ID=REPLACE
REPORTS_BUCKET=REPLACE_PRIVATE_BUCKET
AWS_REGION=REPLACE
