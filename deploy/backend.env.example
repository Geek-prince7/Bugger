# Copy to /etc/bugger/backend.env as root:root mode 600. Never commit real values.
NODE_ENV=production
DATABASE_URL=postgres://bugger:REPLACE_URL_ENCODED_PASSWORD@PRIVATE_RDS_ENDPOINT:5432/bugger
DATABASE_CA_FILE=/run/secrets/database-ca.pem
LICENSE_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SIGNING_KEY_FILE=/run/secrets/signing-private.pem
SIGNING_KEY_ID=bugger-2026-01
JWT_ISSUER=https://api.example.invalid
JWT_AUDIENCE=bugger-extension
HOST=0.0.0.0
PORT=3000
# Docker bridge is not loopback inside container. Set only its verified exact
# gateway IP after setup; false conservatively aggregates IP rate limits.
TRUST_PROXY=false
# Set all four to enable authenticated personal cloud reports, or omit all four.
OIDC_ISSUER=https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID
COGNITO_CLIENT_ID=REPLACE_WITH_PUBLIC_APP_CLIENT_ID
REPORTS_BUCKET=REPLACE_WITH_PRIVATE_REPORTS_BUCKET
AWS_REGION=REPLACE_REGION
